# Port des Node-Servers
PORT=3000

# Öffentliche Basis-URL (für Share-/Invite-Links und WhatsApp-Vorschau).
# Leer lassen = wird aus dem Host-Header abgeleitet.
PUBLIC_URL=

# Pfad zur SQLite-Datei
DATABASE_PATH=./data/bock.db

# Zeitzone, in der Termine interpretiert werden (Parser, Share-Seiten, Erinnerungen)
APP_TZ=Europe/Berlin

# Name der App (UI, Share-Seiten)
APP_NAME=Bock

# Demo-Modus: legt beim ersten Start Demo-Freunde & -Posts an und zeigt Demo-Login-Buttons.
# In Produktion auf false setzen!
DEMO_MODE=true

# Registrierung ohne Einladungslink erlauben (Standard: nein – die App ist privat)
ALLOW_OPEN_SIGNUP=false

# Cookies nur über HTTPS senden (hinter TLS-Reverse-Proxy auf true setzen)
COOKIE_SECURE=false

# --- Vorbereitet, standardmäßig aus: offizielle WhatsApp Business Cloud API ---
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
